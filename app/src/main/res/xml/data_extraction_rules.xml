<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules. Nothing is backed up or transferred:
    the app stores the Telegram API hash and the TDLib login session,
    which must never leave the device. Use the in-app JSON backup instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
