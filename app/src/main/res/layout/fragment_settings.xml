<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="monospace"
            android:text="GramStream"
            android:textColor="#FF9F1C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:fontFamily="monospace"
            android:text="Your Telegram library, as a local streaming addon"
            android:textColor="#808088"
            android:textSize="10sp" />

        <!-- Terminal Log Window -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#16161B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#26262E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="System Logs"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copyLogsButton"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:fontFamily="monospace"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Copy"
                        android:textColor="#FF9F1C"
                        android:textSize="9sp"
                        app:backgroundTint="#26262E"
                        app:cornerRadius="14dp" />

                </LinearLayout>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/logsScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:layout_marginTop="6dp"
                    android:background="#0A0A0C"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/logsTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Loading logs..."
                        android:textColor="#A0A0A0"
                        android:textSize="9sp" />
                </androidx.core.widget.NestedScrollView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Backup Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#16161B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#26262E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Backup Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="Export API credentials, keys, and streaming configs to a JSON backup file."
                    android:textColor="#808088"
                    android:textSize="9sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backupSettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Export Backup"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    app:backgroundTint="#26262E"
                    app:cornerRadius="17dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Account Session Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#16161B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#26262E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Account Session"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logoutButton"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Log Out"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    app:backgroundTint="#D32F2F"
                    app:cornerRadius="17dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Clickable Footer Text -->
        <TextView
            android:id="@+id/vibeCodedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="monospace"
            android:textColor="#808088"
            android:textColorLink="#FF9F1C"
            android:textSize="10sp" />

    </LinearLayout>
</ScrollView>