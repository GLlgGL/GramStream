<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="monospace"
            android:text="GramStream"
            android:textColor="#FF9F1C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:fontFamily="monospace"
            android:text="Your Telegram library, as a local streaming addon"
            android:textColor="#808088"
            android:textSize="10sp" />

        <!-- User Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#16161B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#26262E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/userNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Telegram User"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/userIdText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="ID: Loading..."
                        android:textColor="#808088"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Connected"
                    android:textColor="#388E3C"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Server Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#16161B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#26262E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Text First -->
                    <TextView
                        android:id="@+id/serverStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Server Status"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Circle Indicator After Text -->
                    <View
                        android:id="@+id/serverStatusIndicator"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/shape_circle" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/serverToggleSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="Enable Addon Server"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:thumbTint="#FFFFFF"
                    app:trackTint="@color/switch_track_selector" />

                <!-- Battery Optimization Button (Transparent Background + Border) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/batteryOptButton"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Allow Running in Background"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="17dp"
                    app:strokeColor="#D32F2F"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Remote Access (Cloudflare Tunnel) Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#16161B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#26262E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Remote Access (Cloudflare Tunnel)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tunnelStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="monospace"
                    android:text="Tunnel not running"
                    android:textColor="#808088"
                    android:textSize="10sp" />

                <!-- Default RED when stopped/inactive -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tunnelButton"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:fontFamily="monospace"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Start Cloudflare Tunnel"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    app:backgroundTint="#D32F2F"
                    app:cornerRadius="17dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Manifest & QR Code Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/serverStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#16161B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#26262E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Addon Manifest URL"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/manifestLinkText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#0A0A0C"
                    android:fontFamily="monospace"
                    android:padding="6dp"
                    android:text="http://…/manifest.json"
                    android:textColor="#FF9F1C"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/qrCodeImage"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:background="#FFFFFF"
                    android:contentDescription="Manifest QR Code"
                    android:padding="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copyLinkButton"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Copy Manifest Link"
                    android:textColor="#000000"
                    android:textSize="10sp"
                    app:backgroundTint="#FF9F1C"
                    app:cornerRadius="17dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cache Clear Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#16161B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#26262E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearCacheButton"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:fontFamily="monospace"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Clear Catalog Cache"
                    android:textColor="#FF9F1C"
                    android:textSize="10sp"
                    app:backgroundTint="#2A2A30"
                    app:cornerRadius="17dp"
                    app:strokeColor="#FF9F1C"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>