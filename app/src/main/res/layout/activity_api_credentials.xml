<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="GramStream"
            android:textColor="#FF9F1C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="monospace"
            android:text="Your Telegram library, as a local streaming addon"
            android:textColor="#808088"
            android:textSize="10sp" />

        <!-- Credentials Input Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#16161B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#26262E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Telegram API credentials"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="monospace"
                    android:text="Get these from my.telegram.org → API development tools."
                    android:textColor="#808088"
                    android:textSize="10sp" />

                <!-- API ID Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="API ID"
                    app:boxBackgroundColor="#0A0A0C"
                    app:boxStrokeColor="#FF9F1C"
                    app:hintTextColor="#FF9F1C">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/apiIdInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:inputType="number"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- API Hash Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="API Hash"
                    app:boxBackgroundColor="#0A0A0C"
                    app:boxStrokeColor="#FF9F1C"
                    app:hintTextColor="#FF9F1C">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/apiHashInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:inputType="text"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Small Orange Underlined Restore Text Link -->
                <TextView
                    android:id="@+id/restoreBackupText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:padding="4dp"
                    android:textColor="#FF9F1C"
                    android:textSize="11sp" />

                <!-- Continue Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/continueButton"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Continue"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    app:backgroundTint="#FF9F1C"
                    app:cornerRadius="17dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>