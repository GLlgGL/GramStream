<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="monospace"
            android:text="GramStream"
            android:textColor="#FF9F1C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:fontFamily="monospace"
            android:text="Your Telegram library, as a local streaming addon"
            android:textColor="#808088"
            android:textSize="10sp" />

        <!-- Global Search Switch Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#16161B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#26262E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/globalSearchSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Global Search (All Joined Channels)"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:thumbTint="#FFFFFF"
                    app:trackTint="@color/switch_track_selector" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="If checked, searches all channels you have joined. If unchecked, searches only channels in your added list."
                    android:textColor="#808088"
                    android:textSize="9sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Wi-Fi Only Mode Switch Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#16161B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#26262E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/wifiOnlySwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Wi-Fi Only Mode"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:thumbTint="#FFFFFF"
                    app:trackTint="@color/switch_track_selector" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="If checked, the server only runs on Wi-Fi. If unchecked, mobile data can also be used."
                    android:textColor="#808088"
                    android:textSize="9sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Auto-Start Switch Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#16161B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#26262E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/autoStartSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Auto-start on device boot"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:thumbTint="#FFFFFF"
                    app:trackTint="@color/switch_track_selector" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Streaming & API Key Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#16161B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#26262E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Streaming Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- TMDB API Key Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="TMDB API Key"
                    android:textColor="#808088"
                    android:textSize="10sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:boxBackgroundColor="#0A0A0C"
                    app:boxStrokeColor="#FF9F1C">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tmdbKeyInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Cache Limit Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="Cache Limit (MB)"
                    android:textColor="#808088"
                    android:textSize="10sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:boxBackgroundColor="#0A0A0C"
                    app:boxStrokeColor="#FF9F1C">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/cacheInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:inputType="number"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Buffer Size Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="Buffer Size (MB)"
                    android:textColor="#808088"
                    android:textSize="10sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:boxBackgroundColor="#0A0A0C"
                    app:boxStrokeColor="#FF9F1C">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/bufferInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:inputType="number"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Addon Port Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="Addon Port"
                    android:textColor="#808088"
                    android:textSize="10sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:boxBackgroundColor="#0A0A0C"
                    app:boxStrokeColor="#FF9F1C">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/portInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:inputType="number"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveStreamingSettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Save Streaming Settings"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    app:backgroundTint="#FF9F1C"
                    app:cornerRadius="17dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>